# PostgreSQL connection string (used by pg, Drizzle and drizzle-kit).
# Local dev (host machine → docker-compose postgres, mapped to host port 5433):
DATABASE_URL=postgres://appuser:apppassword@localhost:5433/appdb

# Inside docker compose, the backend service overrides this to:
# DATABASE_URL=postgres://appuser:apppassword@postgres:5432/appdb

# HTTP port for the API server
PORT=8080

# JWT signing secret — required in production, dev fallback is built in
JWT_SECRET=dev-secret-change-me
# Access-token lifetime (jsonwebtoken format, e.g. "7d", "12h")
JWT_EXPIRES_IN=7d

# Allowed browser origins, comma-separated (set this when the frontend
# is deployed on another host, e.g. https://my-app.vercel.app).
# Unset = allow any origin (fine for anonymous practice APIs).
# CORS_ORIGIN=https://my-app.vercel.app
