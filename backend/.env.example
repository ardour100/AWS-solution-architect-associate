# PostgreSQL connection string (used by pg, Drizzle and drizzle-kit).
# Local dev (host machine → docker-compose postgres, mapped to host port 5433):
DATABASE_URL=postgres://appuser:apppassword@localhost:5433/appdb

# Inside docker compose, the backend service overrides this to:
# DATABASE_URL=postgres://appuser:apppassword@postgres:5432/appdb

# HTTP port for the API server
PORT=8080
